{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YHUO001/Research-inbox/schemas/alert_candidate.schema.json",
  "title": "Google Scholar Alert Candidate",
  "description": "Deterministic parser output for one paper-like result extracted from a Google Scholar alert email.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source",
    "position_in_message",
    "title",
    "normalized_title",
    "authors",
    "identifiers",
    "links",
    "parse_status",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 8,
      "description": "Deterministic ID derived from source message ID and result position; it is not the canonical paper ID."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "message_id",
        "received_at",
        "sender",
        "subject"
      ],
      "properties": {
        "source_type": {
          "const": "google_scholar_email"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": ["string", "null"]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "sender": {
          "type": "string",
          "minLength": 3
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "alert_name": {
          "type": ["string", "null"],
          "description": "Alert query/name only when explicitly present in the message; never inferred."
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spf": {
              "type": ["string", "null"],
              "enum": ["pass", "fail", "neutral", "softfail", "none", null]
            },
            "dkim": {
              "type": ["string", "null"],
              "enum": ["pass", "fail", "neutral", "none", null]
            }
          }
        }
      }
    },
    "position_in_message": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "normalized_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "verification_status"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": ["string", "null"]
          },
          "verification_status": {
            "type": "string",
            "enum": ["raw_email", "metadata_verified"]
          }
        }
      }
    },
    "raw_metadata_line": {
      "type": ["string", "null"]
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "verification_status"],
      "properties": {
        "raw": {
          "type": ["string", "null"]
        },
        "normalized": {
          "type": ["string", "null"]
        },
        "verification_status": {
          "type": "string",
          "enum": ["missing", "raw_email", "alias_matched", "metadata_verified"]
        }
      }
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100
    },
    "snippet": {
      "type": ["string", "null"],
      "maxLength": 10000
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "arxiv_id", "pmid"],
      "properties": {
        "doi": {
          "$ref": "#/$defs/identifierEvidence"
        },
        "arxiv_id": {
          "$ref": "#/$defs/identifierEvidence"
        },
        "pmid": {
          "$ref": "#/$defs/identifierEvidence"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_url", "auxiliary_urls"],
      "properties": {
        "primary_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "auxiliary_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        }
      }
    },
    "parse_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "warnings", "errors"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "partial", "manual_review", "rejected"]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parser_strategy": {
          "type": ["string", "null"],
          "enum": ["html_nearest_ancestor", "plain_text_blocks", null]
        }
      }
    },
    "content_fingerprint": {
      "type": ["string", "null"],
      "description": "Hash of normalized title plus selected metadata for parser-level duplicate detection."
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifierEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "verification_status", "source"],
      "properties": {
        "value": {
          "type": ["string", "null"]
        },
        "verification_status": {
          "type": "string",
          "enum": ["missing", "regex_extracted", "metadata_verified"]
        },
        "source": {
          "type": ["string", "null"],
          "enum": ["title", "metadata_line", "snippet", "url", "external_metadata", null]
        }
      }
    }
  }
}
