{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YHUO001/Research-inbox/schemas/openalex_candidate.schema.json",
  "title": "OpenAlex Discovery Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source",
    "position_in_message",
    "title",
    "normalized_title",
    "authors",
    "venue",
    "year",
    "identifiers",
    "links",
    "parse_status",
    "content_fingerprint",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "minLength": 8},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "work_id",
        "discovered_at",
        "query_id",
        "query_text"
      ],
      "properties": {
        "source_type": {"const": "openalex"},
        "work_id": {"type": "string", "minLength": 3},
        "discovered_at": {"type": "string", "format": "date-time"},
        "query_id": {"type": "string", "minLength": 1},
        "query_text": {"type": "string", "minLength": 1},
        "publication_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
        }
      }
    },
    "position_in_message": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "normalized_title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "verification_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "orcid": {"type": ["string", "null"]},
          "verification_status": {"const": "metadata_verified"}
        }
      }
    },
    "raw_metadata_line": {"type": ["string", "null"]},
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "verification_status"],
      "properties": {
        "raw": {"type": ["string", "null"]},
        "normalized": {"type": ["string", "null"]},
        "verification_status": {
          "type": "string",
          "enum": ["missing", "metadata_verified"]
        }
      }
    },
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
    "snippet": {"type": ["string", "null"], "maxLength": 10000},
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "arxiv_id", "pmid"],
      "properties": {
        "doi": {"$ref": "#/$defs/identifierEvidence"},
        "arxiv_id": {"$ref": "#/$defs/identifierEvidence"},
        "pmid": {"$ref": "#/$defs/identifierEvidence"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_url", "auxiliary_urls"],
      "properties": {
        "primary_url": {"type": ["string", "null"], "format": "uri"},
        "auxiliary_urls": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true
        }
      }
    },
    "parse_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "warnings", "errors", "parser_strategy"],
      "properties": {
        "state": {"type": "string", "enum": ["complete", "partial", "rejected"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "parser_strategy": {"const": "openalex_api"}
      }
    },
    "content_fingerprint": {"type": "string", "minLength": 32},
    "extracted_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifierEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "verification_status", "source"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "verification_status": {
          "type": "string",
          "enum": ["missing", "metadata_verified"]
        },
        "source": {
          "type": ["string", "null"],
          "enum": ["external_metadata", null]
        }
      }
    }
  }
}
