{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YHUO001/Research-inbox/schemas/paper_summary.schema.json",
  "title": "Grounded Chinese Paper Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary_version",
    "candidate_id",
    "output_language",
    "core_problem",
    "method_and_architecture",
    "method_principle",
    "method_implementation",
    "main_contributions",
    "reported_results",
    "distinction_from_prior_work",
    "research_value",
    "limitations_and_open_questions",
    "optical_neural_network_analysis",
    "zeroth_order_analysis",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "summary_version": {"const": 2},
    "candidate_id": {"type": "string", "minLength": 8},
    "output_language": {"const": "zh-CN"},
    "core_problem": {"type": "string", "minLength": 20, "maxLength": 1600},
    "method_and_architecture": {"type": "string", "minLength": 40, "maxLength": 1800},
    "method_principle": {"type": "string", "minLength": 160, "maxLength": 3200},
    "method_implementation": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 60, "maxLength": 1400}
    },
    "main_contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 10, "maxLength": 900}
    },
    "reported_results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "reported_by_authors", "basis"],
        "properties": {
          "claim": {"type": "string", "minLength": 10, "maxLength": 900},
          "reported_by_authors": {"const": true},
          "basis": {"type": "string", "enum": ["abstract", "title_and_metadata", "not_available"]}
        }
      }
    },
    "distinction_from_prior_work": {"type": "string", "minLength": 10, "maxLength": 1600},
    "research_value": {"type": "string", "minLength": 20, "maxLength": 1600},
    "limitations_and_open_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 10, "maxLength": 900}
    },
    "optical_neural_network_analysis": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "architecture_type",
            "training_method",
            "optical_nonlinearity",
            "calibration_requirements",
            "application_tasks",
            "hardware_validation"
          ],
          "properties": {
            "architecture_type": {"type": "string", "enum": ["free_space", "integrated", "hybrid", "unclear", "not_available"]},
            "training_method": {"type": "string", "maxLength": 1200},
            "optical_nonlinearity": {"type": "string", "maxLength": 1200},
            "calibration_requirements": {"type": "string", "maxLength": 1200},
            "application_tasks": {"type": "array", "items": {"type": "string", "maxLength": 400}},
            "hardware_validation": {"type": "string", "enum": ["physical_experiment", "simulation_only", "mixed", "unclear", "not_available"]}
          }
        }
      ]
    },
    "zeroth_order_analysis": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_query_reduction_claim",
            "per_step_vs_total_clarity",
            "query_reuse",
            "low_rank_or_subspace",
            "structured_perturbation",
            "forward_only"
          ],
          "properties": {
            "total_query_reduction_claim": {"type": "string", "enum": ["yes", "no", "not_available"]},
            "per_step_vs_total_clarity": {"type": "string", "maxLength": 1200},
            "query_reuse": {"type": "string", "maxLength": 1200},
            "low_rank_or_subspace": {"type": "string", "maxLength": 1200},
            "structured_perturbation": {"type": "string", "maxLength": 1200},
            "forward_only": {"type": "string", "maxLength": 1200}
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "information_basis",
        "full_text_method_context_used",
        "full_text_method_source_url",
        "unsupported_numbers_detected",
        "missing_information"
      ],
      "properties": {
        "information_basis": {
          "type": "string",
          "enum": [
            "title_metadata_and_abstract_only",
            "title_metadata_abstract_and_open_full_text_methods"
          ]
        },
        "full_text_method_context_used": {"type": "boolean"},
        "full_text_method_source_url": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "uri"}
          ]
        },
        "unsupported_numbers_detected": {"const": false},
        "missing_information": {"type": "array", "items": {"type": "string", "maxLength": 400}}
      }
    }
  }
}
