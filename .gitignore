# Generated research-inbox data
# Never commit raw email contents, downloaded papers, normalized private data, or logs.
data/raw/*
!data/raw/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
logs/*
!logs/.gitkeep

# Local databases, caches, and downloaded documents
*.sqlite
*.sqlite3
*.db
*.pdf
cache/
downloads/
